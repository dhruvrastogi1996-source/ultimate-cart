// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                 String    @id
  shop               String
  state              String
  isOnline           Boolean   @default(false)
  scope              String?
  expires            DateTime?
  accessToken        String
  userId             BigInt?
  firstName          String?
  lastName           String?
  email              String?
  accountOwner       Boolean   @default(false)
  locale             String?
  collaborator       Boolean?  @default(false)
  emailVerified      Boolean?  @default(false)
  refreshToken       String?
  refreshTokenExpires DateTime?
}

model Market {
  id                 String      @id @default(cuid())
  shop               String
  code               String
  name               String
  currency           String      @default("INR")
  flag               String      @default("")
  enabled            Boolean     @default(true)
  progressStyle      String      @default("segmented")
  milestoneType      String      @default("cart_value")
  allUnlockedMessage String      @default("All rewards unlocked. Now go look fabulous.")
  trustBadges        String      @default("[]")
  milestones         Milestone[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([shop, code])
}

model Milestone {
  id            String   @id @default(cuid())
  marketId      String
  market        Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  threshold     Float    @default(0)
  rewardLabel   String   @default("")
  rewardType    String   @default("no_discount")
  discountPct   Float?
  fixedDiscount Float?
  icon          String   @default("Truck")
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CartNoteRule {
  id               String   @id @default(cuid())
  shop             String
  trigger          String   @default("always")
  selectedVariants String   @default("[]")
  selectedProducts String   @default("[]")
  prompt           String   @default("")
  placeholder      String   @default("")
  required         Boolean  @default(false)
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ThemeSettings {
  id           String   @id @default(cuid())
  shop         String   @unique
  bgColor      String   @default("#FFFFFF")
  textColor    String   @default("#1A1A1A")
  accentColor  String   @default("#8B0000")
  headingFont  String   @default("Cormorant Garamond")
  bodyFont     String   @default("Inter")
  buttonStyle  String   @default("square")
  borderRadius String   @default("none")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UpsellProduct {
  id           String   @id @default(cuid())
  shop         String
  productId    String
  productTitle String
  productHandle String
  imageUrl     String   @default("")
  price        String   @default("")
  sortOrder    Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
